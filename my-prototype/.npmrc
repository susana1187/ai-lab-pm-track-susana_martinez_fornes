# LiveRamp's private registry serves the @liveramp/* packages (Motif, icons,
# RichDataTable). You must be on the LiveRamp VPN for this to resolve.
@liveramp:registry=https://library.liveramp.net/artifactory/api/npm/npm

# Motif (4.x) pins MUI 5, whose peer ranges predate React 18/19. This flag lets
# the install resolve cleanly instead of erroring on a peer-version mismatch.
legacy-peer-deps=true
